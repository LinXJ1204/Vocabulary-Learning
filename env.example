# NOTE:
# This repo environment blocks committing `.env.example` in this workspace.
# Use this file as the template and copy it to:
# - `apps/api/.env`
# - `apps/web/.env.local`

# API (apps/api)
PORT=4000
API_BASE_URL="http://localhost:4000"
WEB_BASE_URL="http://localhost:3000"
JWT_SECRET="dev-secret-change-me"
DAILY_ADD_LIMIT="30"

# Google OAuth (apps/api)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Postgres (docker-compose uses port 5435 on host)
DATABASE_URL="postgresql://evb:evb_password@localhost:5435/evb_dev?schema=public"

# Web (apps/web)
# Browser/public API base URL (links, OAuth)
API_BASE_URL="http://localhost:4000"
# Server-side internal API base URL (for Docker: http://api:4000)
API_INTERNAL_BASE_URL=""

# AI (apps/api)
# TRANSLATION_PROVIDER=stub|gemini
TRANSLATION_PROVIDER="stub"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
