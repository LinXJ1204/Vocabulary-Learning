{
  "name": "@evb/api",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@evb/shared-types": "workspace:*",
    "@prisma/client": "^6.2.1",
    "@google/generative-ai": "^0.24.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/express": "^4.17.21",
    "@types/cookie-parser": "^1.4.7",
    "@types/jsonwebtoken": "^9.0.7",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "pnpm --filter @evb/shared-types build && prisma generate && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @evb/shared-types build && prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "echo \"no lint\""
  }
}

